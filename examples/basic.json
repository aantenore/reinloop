{
  "$schema": "../schema/reinloop.schema.json",
  "providers": {
    "offline": {
      "type": "mock",
      "responses": [
        { "toolCalls": [{ "name": "list_dir", "args": { "path": "." } }] },
        { "text": "I listed the directory. Replace the mock provider with a real one to get real answers." }
