{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/access-question.json",
  "title": "AccessQuestion",
  "description": "Question put to AuthorizationPort (layer identity): may this caller do this action on this target.",
  "type": "object",
  "required": ["caller", "action", "target"],
  "properties": {
    "caller": {
      "anyOf": [
        { "$ref": "common.json#/$defs/PublicCaller" },
        { "$ref": "common.json#/$defs/AnonymousCaller" }
      ]
    },
    "action": { "$ref": "common.json#/$defs/Action" },
    "target": { "$ref": "#/$defs/AccessTarget" },
    "args": {
      "type": "object",
      "description": "The call arguments; an adapter sends them on only when configured to."
    },
    "ext": { "$ref": "common.json#/$defs/Ext" }
  },
  "additionalProperties": false,
  "$defs": {
    "AccessTarget": {
      "type": "object",
      "required": ["kind", "id", "layer", "risk", "agent"],
      "properties": {
        "kind": { "type": "string", "description": "tool today." },
        "id": { "type": "string" },
        "layer": { "$ref": "common.json#/$defs/Layer" },
        "risk": { "$ref": "common.json#/$defs/Risk" },
        "agent": { "type": "string" },
        "attrs": { "$ref": "common.json#/$defs/Attrs" }
      },
      "additionalProperties": false,
      "description": "What is being accessed."
    }
  },
  "examples": [
    {
      "caller": {
        "id": "u-1042",
        "kind": "user",
        "roles": ["support"],
        "scopes": ["orders:read"],
        "name": "Mara Rossi"
      },
      "action": "call",
      "target": {
        "kind": "tool",
        "id": "crm__lookup",
        "layer": "tool",
        "risk": "read",
        "agent": "support",
        "attrs": { "owner": "sales" }
      },
      "args": { "customer": "C-77" }
    }
  ]
}
